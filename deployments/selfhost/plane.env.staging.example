# =============================================================================
# TEMPLATE — staging environment for the The1Studio Plane fork.
#
# This file is a template. The REAL file lives at
#   /opt/plane-staging-app/plane.env
# on the `server` host, is not in git, and never will be.
#
# Copy it there and fill in every <GENERATE> placeholder. Nothing below is a
# usable secret — a value left as <GENERATE> will fail loudly rather than
# quietly working with a shared or guessable key.
#
# Generate each secret independently:
#   openssl rand -hex 32
#
# DO NOT copy secrets across from /opt/plane-fork-app/plane.env. A shared
# SECRET_KEY means a session token minted in staging validates in production.
#
# Key set mirrors production's plane.env as of 2026-08-26 (52 keys), minus
# AWS_S3_ENDPOINT_URL — see the object-storage section for why that absence
# is deliberate.
# Layout matches deployments/cli/community/docker-compose.yml.
# =============================================================================

# ----- Identity / routing -----------------------------------------------------
# The Cloudflare tunnel hostname. Must match the public hostname's ingress rule,
# which points at http://localhost:81. See phase-4.md step 4.
APP_DOMAIN=plane-staging.the1studio.org
WEB_URL=https://plane-staging.the1studio.org
# Production's origin must NOT appear here.
CORS_ALLOWED_ORIGINS=https://plane-staging.the1studio.org

# deploy.sh rewrites this to $IMAGE_TAG on every run. Seeded correctly so a
# manual `docker compose up` before the first CI deploy uses the local staging
# images instead of pulling `stable` from Docker Hub.
APP_RELEASE=staging

# ----- Host ports -------------------------------------------------------------
# Verified free on server 2026-08-26. If you change these, change them in THREE
# places in lockstep: here, HEALTH_HTTP_PORT in .github/workflows/deploy-staging.yml,
# and the Cloudflare ingress rule. Two out of three gives a green deploy behind
# an unreachable hostname.
LISTEN_HTTP_PORT=81
LISTEN_HTTPS_PORT=8543

# Container-internal listen address. Cloudflare terminates TLS at its edge, so
# Caddy must not attempt ACME. Same as production.
SITE_ADDRESS=:80
CERT_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
CERT_EMAIL=
CERT_ACME_DNS=
TRUSTED_PROXIES=0.0.0.0/0

# ----- Scale ------------------------------------------------------------------
# All pinned to 1. Staging shares 31G of RAM with production, which measured an
# 8G footprint on 2026-08-26. See deployments/selfhost/README.md § Resource budget.
WEB_REPLICAS=1
SPACE_REPLICAS=1
ADMIN_REPLICAS=1
API_REPLICAS=1
WORKER_REPLICAS=1
BEAT_WORKER_REPLICAS=1
LIVE_REPLICAS=1
GUNICORN_WORKERS=1

# ----- App --------------------------------------------------------------------
# DEBUG stays 0. Staging mirrors production deliberately: turning it on changes
# Django's error handling and would mask the very failures staging exists to catch.
DEBUG=0
API_BASE_URL=http://api:8000
SECRET_KEY=<GENERATE>
LIVE_SERVER_SECRET_KEY=<GENERATE>
API_KEY_RATE_LIMIT=60/minute
AUTHENTICATION_RATE_LIMIT=10/minute
WEBHOOK_ALLOWED_IPS=
WEBHOOK_ALLOWED_HOSTS=

# ----- Postgres ---------------------------------------------------------------
# Staging runs its OWN local postgres. Production does not: its DATABASE_URL
# points at Neon (pg17.11), and the bundled plane-db container is gated off
# there via LOCAL_DB=0.
#
# deploy.sh patches the image to $PG_IMAGE, which deploy-staging.yml pins to
# pgvector/pgvector:pg17 — matching Neon's major version, so a migration
# rehearsed here meets the same engine it will meet in production. (pgvector
# rather than plain postgres because ai_ext needs the extension.)
#
# The volume is plane-staging-app_pgdata, entirely separate from production's
# now-unused plane-fork-app_pgdata.
PGHOST=plane-db
PGDATABASE=plane
POSTGRES_USER=plane
POSTGRES_PASSWORD=<GENERATE>
POSTGRES_DB=plane
POSTGRES_PORT=5432
PGDATA=/var/lib/postgresql/data
DATABASE_URL=postgresql://plane:<GENERATE>@plane-db/plane

# ----- Redis ------------------------------------------------------------------
REDIS_HOST=plane-redis
REDIS_PORT=6379
REDIS_URL=

# ----- RabbitMQ ---------------------------------------------------------------
RABBITMQ_HOST=plane-mq
RABBITMQ_PORT=5672
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=<GENERATE>
RABBITMQ_VHOST=plane
AMQP_URL=amqp://plane:<GENERATE>@plane-mq:5672/plane

# ----- Object storage ---------------------------------------------------------
# Staging uses the LOCAL MinIO container that ships in the community compose.
#
# READ THIS BEFORE EDITING. USE_MINIO=1 selects MinIO, but what actually makes
# it impossible for staging to write into production's R2 bucket is that this
# file carries NO R2 credentials and NO AWS_S3_ENDPOINT_URL at all. A flag can
# be flipped by a future edit; a credential that was never here cannot be.
#
# Do NOT "helpfully" copy AWS_S3_ENDPOINT_URL or the R2 keys across from
# production. Staging writing into plane-uploads would destroy real user files.
USE_MINIO=1
MINIO_ENDPOINT_SSL=0
AWS_REGION=auto
# These double as the MinIO root credentials (x-minio-env in the compose file),
# so they must be set — just never to production's R2 keys.
AWS_ACCESS_KEY_ID=<GENERATE>
AWS_SECRET_ACCESS_KEY=<GENERATE>
# The compose default; MinIO creates this bucket locally on first boot.
AWS_S3_BUCKET_NAME=uploads
FILE_SIZE_LIMIT=104857600
