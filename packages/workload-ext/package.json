{
  "name": "@plane/workload-ext",
  "version": "0.1.0",
  "private": true,
  "description": "SP2 workload extension — per-person hour matrix",
  "license": "AGPL-3.0",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --no-clean",
    "check:types": "tsc --noEmit",
